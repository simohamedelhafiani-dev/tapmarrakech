# Frontend values (safe to expose in the browser; never put secrets behind VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=

# Server-only Supabase Edge Function secrets. Set with `supabase secrets set`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Meta secrets. Use the same app and API version as the Meta app setup.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v27.0
META_WEBHOOK_VERIFY_TOKEN=
KELYANI_APP_ORIGIN=https://your-production-domain.example
