{
  "rewrites": [
    {
      "source": "/loyalty/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|discordbot|googlebot|bingbot|pinterest|applebot|redditbot|embedly|skypeuripreview)"
        }
      ],
      "destination": "/api/loyalty-share?token=:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
